{
  "name": "VortesInsight",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#6250d6", "#e34948"],
  "background": "#FFFFFF",
  "foreground": "#0b0b0b",
  "tableAccent": "#0F3D5E",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#0F3D5E" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0b0b0b" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0F3D5E" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52514e" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "visualHeader": [{ "show": true }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F7FA" } }, "transparency": 0 }]
      }
    }
  }
}
